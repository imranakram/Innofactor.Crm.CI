<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="Microsoft.Bcl.AsyncInterfaces" version="8.0.0" targetFramework="net462" />
  <package id="Microsoft.CrmSdk.CoreAssemblies" version="9.0.2.59" targetFramework="net462" />
  <package id="Microsoft.CrmSdk.Deployment" version="9.0.2.34" targetFramework="net462" />
  <package id="Microsoft.CrmSdk.Workflow" version="9.0.2.59" targetFramework="net462" />
  <package id="Microsoft.CrmSdk.XrmTooling.CoreAssembly" version="9.1.1.65" targetFramework="net462" />
  <package id="Microsoft.IdentityModel" version="7.0.0" targetFramework="net462" />
  <!-- Pinned, and required rather than a workaround.
       Microsoft.Xrm.Tooling.Connector 4.0.0.0 (package 9.1.1.65, the newest published)
       is compiled against Microsoft.IdentityModel.Clients.ActiveDirectory 3.19.8.16603
       exactly, so strong-name binding demands that exact version. Overriding it needs a
       binding redirect, which must live in the HOST process config - powershell.exe.config
       on the build agent - and an extension cannot modify that. A library .dll.config is
       ignored, which is why no .config ships in the vsix.
       This is not a PowerShell limitation: ADAL 5.x loads into PS 5.1 fine on its own.
       There is no newer XrmTooling that binds a newer ADAL, so the only way off ADAL 3.x
       is off CrmServiceClient entirely - which Microsoft's own transition guidance advises
       against while on-prem AD/IFD must be supported.
       Do not "upgrade" this. See also Cmdlets/*/packages.config - all must match. -->
  <package id="Microsoft.IdentityModel.Clients.ActiveDirectory" version="3.19.8" targetFramework="net462" allowedVersions="[3.19.8]" />
  <package id="Microsoft.NETCore.Platforms" version="1.1.1" targetFramework="net462" />
